APP_NAME=EduPlatform
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0+ connection. Create the database and a dedicated user first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=replace-with-a-local-database-password
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Where backups may be written. Leave empty to keep them in
# backend/storage/app/backups. A server owner can point this at another disk,
# for example an external drive; the Super Admin then picks a folder inside
# the "backups" area below it. The panel never shows this absolute path.
BACKUP_BASE=

# Extra absolute destinations the server owner authorises, separated by commas.
# The Super Admin can browse and pick folders inside these roots only.
# Example: BACKUP_ROOTS=D:\Backups,E:\Nightly-Backups
BACKUP_ROOTS=

# Largest restore upload in bytes (default 100 MB) and the longest a single
# restore may run, in seconds (default 300).
BACKUP_MAX_UPLOAD_BYTES=104857600
BACKUP_RESTORE_TIMEOUT=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.local"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum is used for API authentication. Add real frontend origins later.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
