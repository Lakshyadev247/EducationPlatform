# Production environment template.
#
# Copy this file to .env on the server and fill in the values. Never commit a
# filled-in .env: every .env.* file is ignored by git except the *.example
# templates.
#
# Difference from .env.example (which is for local development):
#   APP_DEBUG=false            no stack traces, no environment values in errors
#   LOG_LEVEL=info             no debug noise in the daily log
#   SESSION_SECURE_COOKIE=true the session cookie is sent over HTTPS only
#   APP_URL / SANCTUM_STATEFUL_DOMAINS  the real public domain
#   MAIL_MAILER=smtp            real mail, required for account verification
#                               and password recovery
#   WHATSAPP_ACCESS_TOKEN      server-side only; never entered in the browser

APP_NAME=EduPlatform
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Databases that may be emptied by a command (migrate:fresh, db:wipe, db:seed).
# Leave this empty on a production server: the application refuses any command
# that can empty a database which is not listed here.
DISPOSABLE_DATABASES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL 8.0+ connection. Use a dedicated account with only the privileges the
# application needs, and never the root account.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=replace-with-the-production-database-password
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Where backups may be written. Leave empty to keep them in
# backend/storage/app/backups. A server owner can point this at another disk,
# for example a mounted external drive; the Super Admin then picks a folder
# inside the "backups" area below it. The panel never shows this path.
BACKUP_BASE=

# Extra absolute destinations the server owner authorises, separated by commas.
# The Super Admin can browse and pick folders inside these roots only.
BACKUP_ROOTS=

# Largest restore upload in bytes (default 100 MB) and the longest a single
# restore may run, in seconds (default 300). Restore is refused in production
# and on every schema not listed in DISPOSABLE_DATABASES.
BACKUP_MAX_UPLOAD_BYTES=104857600
BACKUP_RESTORE_TIMEOUT=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum stateful domains: the public origin of the application.
SANCTUM_STATEFUL_DOMAINS=example.com

# WhatsApp Business Platform credentials. Read on the server only; they are
# never stored in the database and never returned by the API.
# WHATSAPP_ACCESS_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
